// Cloudflare Workers deployment: serve the static export in out/ as static
// assets. There is no server code; this file stops `wrangler deploy` from
// trying to convert the project into a server-rendered Next.js app.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aidcf-site",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./out",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
